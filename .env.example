PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=./data/academy.sqlite
# Confirm the merchant's gateway before enabling checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Verified Resend sender and a private, random secret of at least 32 characters.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
AUTH_SECRET=
# Public OAuth web client ID. Allow the exact website origin in Google Cloud.
GOOGLE_CLIENT_ID=
# Required for paid enrollment. Review legal drafts first.
LEGAL_APPROVED=false
# Only enable behind a single trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Set only after launch approval. HTTPS origin without trailing slash.
PUBLIC_ORIGIN=
