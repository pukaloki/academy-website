# ============================================================
# The Shortcut Academy — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3100
NODE_ENV=production
DATABASE_PATH=/var/lib/shortcut-academy/academy.sqlite

# --- Razorpay Payment Gateway ---
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# Get from: Dashboard → Settings → Webhooks → Create webhook
# URL: https://yourdomain.com/api/webhooks/razorpay
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Email (Resend) ---
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# --- Session Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Google OAuth ---
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID → Web application
# Add authorized origin: https://yourdomain.com
GOOGLE_CLIENT_ID=XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com

# --- Feature Flags ---
# Set to true after reviewing legal/terms of service
LEGAL_APPROVED=true
# Set to true when behind a reverse proxy (Nginx)
TRUST_PROXY=true

# --- Production Domain ---
# Your HTTPS domain without trailing slash
PUBLIC_ORIGIN=https://yourdomain.com
